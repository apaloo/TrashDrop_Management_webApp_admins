# TrashDrop Management WebApp Admin Portal - Environment Variables
# Copy this file to .env.local for development or set these variables in your deployment environment

# Core Settings
REACT_APP_DOMAIN=trashdrop.com
REACT_APP_BASE_URL=https://admin.trashdrop.com
REACT_APP_API_BASE_URL=https://api.trashdrop.com

# Supabase Configuration (REQUIRED)
REACT_APP_SUPABASE_URL=your_supabase_url
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key
# SECURITY NOTE: Never use service keys in frontend code
# For admin operations, use Supabase Edge Functions or a backend API

# Authentication Settings
REACT_APP_USE_DEV_AUTH=false
REACT_APP_DEV_USER_EMAIL=admin@trashdrop.com
REACT_APP_ADMIN_EMAIL=admin@trashdrop.com
REACT_APP_SUPPORT_EMAIL=support@trashdrop.com

# Feature Flags
REACT_APP_ENABLE_LIVE_MAP=true
REACT_APP_ENABLE_REALTIME_ALERTS=true
REACT_APP_ENABLE_BATCH_OPERATIONS=true
REACT_APP_ENABLE_PERFORMANCE_MONITORING=true
REACT_APP_ENABLE_REALTIME_SUBSCRIPTIONS=true

# Social Media Feeds (Optional - for live social feed integration)
# Twitter/X API Bearer Token (from https://developer.twitter.com/)
REACT_APP_TWITTER_BEARER_TOKEN=your_twitter_bearer_token
# Facebook Profile to monitor (e.g., https://web.facebook.com/profile.php?id=100071279183559)
REACT_APP_FACEBOOK_PROFILE_ID=100071279183559
# Server-side proxy URL for Meta/TikTok APIs (Supabase Edge Function or custom backend)
REACT_APP_SOCIAL_PROXY_URL=

# Deployment Settings
# Set to 'production' when deploying to production environments
NODE_ENV=development
