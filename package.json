{
  "name": "trashdrop-admin-portal",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.6",
    "@sentry/react": "8.55.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^9.3.4",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/file-saver": "^2.0.7",
    "autoprefixer": "^10.6.2",
    "chart.js": "^4.6.1",
    "date-fns": "^2.30.0",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "1.5.3",
    "postcss": "^8.5.32",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.10",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "react-leaflet": "^4.2.1",
    "react-leaflet-cluster": "2.1.0",
    "react-router-dom": "^7.18.5",
    "react-toastify": "^11.2.0",
    "tailwindcss": "^3.4.19",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "postbuild": "node scripts/prerender.js",
    "preview": "vite preview",
    "build:netlify": "npm install --legacy-peer-deps && npm run build",
    "test": "jest --watch",
    "test:ci": "node scripts/ci/run-tests.js",
    "lint": "eslint src --ext .js,.jsx",
    "lint:fix": "eslint src --ext .js,.jsx --fix",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:test": "start-server-and-test start http://localhost:3000 cy:run",
    "prepare": "node -e \"if (process.env.NODE_ENV !== 'production' && process.env.CI !== 'true') { require('child_process').execSync('husky install', {stdio: 'inherit'}) }\""
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "no-console": [
        "warn",
        {
          "allow": [
            "warn",
            "error"
          ]
        }
      ]
    },
    "overrides": [
      {
        "files": [
          "src/**/__tests__/**",
          "src/**/*.test.js",
          "src/setupTests.js"
        ],
        "rules": {
          "no-console": "off",
          "testing-library/no-node-access": "warn",
          "testing-library/no-container": "warn",
          "testing-library/no-unnecessary-act": "warn",
          "testing-library/no-wait-for-multiple-assertions": "warn",
          "testing-library/render-result-naming-convention": "warn",
          "testing-library/prefer-find-by": "warn"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@sparticuz/chromium": "121.0.0",
    "@testing-library/cypress": "^9.0.0",
    "@testing-library/react-hooks": "^7.0.2",
    "@vitejs/plugin-react": "^4.7.0",
    "babel-jest": "^27.5.1",
    "babel-preset-react-app": "^10.1.0",
    "camelcase": "^6.3.0",
    "cypress": "^12.17.4",
    "eslint": "^8.57.1",
    "eslint-config-react-app": "^7.0.1",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^27.5.1",
    "puppeteer-core": "21.11.0",
    "react-app-polyfill": "^3.0.0",
    "react-test-renderer": "^18.3.1",
    "start-server-and-test": "^2.1.5",
    "vite": "^6.4.6"
  }
}
