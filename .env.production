REACT_APP_SUPABASE_URL=https://tfdedlqdsajjdjkerkli.supabase.co
# REACT_APP_SUPABASE_ANON_KEY is set in Netlify environment variables (and .env.production.local for local builds).
REACT_APP_USE_DEV_AUTH=false
NODE_OPTIONS=--legacy-peer-deps
# Real data only, as in .env.development (production used to fall back to the
# lax "DEVELOPMENT MODE" because these were only set there).
REACT_APP_FORCE_LIVE_DATA=true
REACT_APP_DISABLE_MOCK_DATA=true
# REACT_APP_REQUIRE_DATABASE stays off in production: it checks the table
# exists (an exact row count) before every query, doubling database calls.
