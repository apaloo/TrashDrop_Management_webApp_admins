# TrashDrop Management WebApp Admin Portal - Development Environment
# This configuration allows development without real Supabase credentials

# Core Settings
REACT_APP_DOMAIN=trashdrops.com
REACT_APP_BASE_URL=https://admin.trashdrops.com
REACT_APP_API_BASE_URL=https://api.trashdrops.com

# Supabase Configuration - Use mock/development values
REACT_APP_SUPABASE_URL=https://tfdedlqdsajjdjkerkli.supabase.co
# Publishable key (public by design). The legacy JWT anon key was disabled on 2026-11-11.
REACT_APP_SUPABASE_ANON_KEY=sb_publishable_Jn1AMgxT5vxwT2pUvBUJ-Q_-GJ79NfH
# Service-role key removed: it must never be committed or exposed to the browser.

# Development Mode Configuration  
# PRODUCTION MODE: Real data only, no mock fallbacks (Mock data deprecated)
REACT_APP_FORCE_LIVE_DATA=true
REACT_APP_DISABLE_MOCK_DATA=true
REACT_APP_REQUIRE_DATABASE=true
REACT_APP_THROW_ON_MISSING=true
REACT_APP_USE_DEV_AUTH=false

# Feature Flags - Development Mode - ALL ENABLED FOR DIRECT SUPABASE READS
REACT_APP_ENABLE_LIVE_MAP=true
REACT_APP_ENABLE_REALTIME_ALERTS=true
REACT_APP_ENABLE_BATCH_OPERATIONS=true
REACT_APP_ENABLE_PERFORMANCE_MONITORING=true
REACT_APP_ENABLE_REALTIME_SUBSCRIPTIONS=true

# Development environment
NODE_ENV=development
