    </div>
    
    <!-- Load JavaScript libraries -->    
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="js/data-service.js"></script>
    <script src="js/dashboard-controller.js"></script>
    <script src="js/map-service.js"></script>
    <script src="js/request-service.js"></script>
    <script src="js/bin-management.js"></script>
    <script src="js/illegal-dumping-management.js"></script>
    <script src="js/menu-navigation.js"></script>
    <script>
        // Initialize all services and UI interactions when DOM is loaded
        $(document).ready(function() {
            console.log('Document ready, initializing services...');
            
            // Initialize map service
            try {
                MapService.init('map-container');
                console.log('Map service initialized successfully');
            } catch (error) {
                console.error('Error initializing map service:', error);
            }
            
            // Initialize request service
            try {
                RequestService.init();
                console.log('Request service initialized successfully');
            } catch (error) {
                console.error('Error initializing request service:', error);
            }
            
            // Direct access to DOM elements for debugging
            console.log('Dashboard link:', $('#dashboard-link').length ? 'Found' : 'Not found');
            console.log('Live Map link:', $('#live-map-link').length ? 'Found' : 'Not found');
            console.log('Collectors link:', $('#collectors-link').length ? 'Found' : 'Not found');
            
            // Function to switch content sections - now delegated to MenuNavigation module
            function switchToSection(sectionId, linkText) {
                console.log('Legacy switchToSection called, delegating to MenuNavigation module');
                if (typeof MenuNavigation !== 'undefined') {
                    MenuNavigation.switchToSection(sectionId, linkText);
                } else {
                    console.error('MenuNavigation module not loaded');
                    
                    // Fallback implementation if MenuNavigation is not available
                    // Hide all content sections first
                    $('.content-section').addClass('hidden');
                    
                    // Show the selected section
                    $('#' + sectionId).removeClass('hidden');
                    
                    // Update the page title
                    document.title = 'TrashDrop Admin - ' + linkText;
                    
                    // Update the breadcrumb
                    $('#page-title').text(linkText);
                }
            }
            
            // Simplified jQuery event handlers for all navigation elements
            
            // Toggle submenu functionality
            $('.sidebar-link').on('click', function(e) {
                e.preventDefault();
                console.log('Clicked on sidebar link');
                
                // Check for data-target attribute first (new approach)
                const target = $(this).data('target');
                if (target) {
                    const submenuId = target + '-submenu';
                    const submenu = $('#' + submenuId);
                    
                    if (submenu.length) {
                        // Toggle submenu visibility
                        $(this).toggleClass('open');
                        submenu.toggleClass('open'); // Changed from 'hidden' to 'open' to match CSS classes
                        console.log('Toggled submenu:', submenuId);
                        return false;
                    }
                }
                
                // Fall back to old approach using ID
                const submenuId = this.id.replace('-link', '-submenu');
                const submenu = $('#' + submenuId);
                
                if (submenu.length) {
                    $(this).toggleClass('open');
                    submenu.toggleClass('open');
                    console.log('Toggled submenu:', submenuId);
                }
                
                return false; // Ensure the click doesn't propagate
            });
            
            // Handle all submenu link clicks with direct jQuery binding
            $('.submenu-link').on('click', function(e) {
                e.preventDefault();
                e.stopPropagation(); // Stop event bubbling
                
                const linkText = $(this).find('span').text();
                console.log('Clicked on submenu link:', linkText);
                
                // Remove active class from all submenu links
                $('.submenu-link').removeClass('active');
                
                // Add active class to clicked link
                $(this).addClass('active');
                
                // Determine which section to show based on link ID or text
                const linkId = this.id;
                const linkTextLower = linkText.toLowerCase().trim();
                let sectionId;
                
                if (linkId === 'dashboard-link' || linkTextLower === 'dashboard') {
                    sectionId = 'dashboard-section';
                } else if (linkId === 'live-map-link' || linkTextLower === 'live map') {
                    sectionId = 'live-map-section';
                } else if (linkId === 'collectors-link' || linkTextLower === 'collectors') {
                    sectionId = 'collectors-section';
                } else if (linkId === 'pickup-requests-link' || linkTextLower === 'pickup requests') {
                    sectionId = 'pickup-requests-section';
                } else if (linkId === 'analytics-link' || linkTextLower.includes('analytics') || linkTextLower.includes('reports')) {
                    sectionId = 'analytics-section';
                } else if (linkId === 'alerts-link' || linkTextLower.includes('alerts') || linkTextLower.includes('notifications')) {
                    sectionId = 'alerts-section';
                } else if (linkId === 'bin-management-link' || linkTextLower.includes('bin') || linkTextLower.includes('bag')) {
                    sectionId = 'bin-management-section';
                    
                    // Special handling for bin management submenu tabs
                    if (linkTextLower.includes('generate')) {
                        // Activate Generate Bag tab
                        $('.tab-pane').removeClass('active').addClass('hidden');
                        $('#generate-bag-content').removeClass('hidden').addClass('active');
                        $('[data-tab]').removeClass('active text-blue-600 border-blue-600').addClass('text-gray-500 border-transparent');
                        $('[data-tab="generate-bag"]').addClass('active text-blue-600 border-blue-600').removeClass('text-gray-500 border-transparent');
                    } else if (linkTextLower.includes('management')) {
                        // Activate Bag Management tab
                        $('.tab-pane').removeClass('active').addClass('hidden');
                        $('#bag-management-content').removeClass('hidden').addClass('active');
                        $('[data-tab]').removeClass('active text-blue-600 border-blue-600').addClass('text-gray-500 border-transparent');
                        $('[data-tab="bag-management"]').addClass('active text-blue-600 border-blue-600').removeClass('text-gray-500 border-transparent');
                    } else if (linkTextLower.includes('history')) {
                        // Activate Bag History tab
                        $('.tab-pane').removeClass('active').addClass('hidden');
                        $('#bag-history-content').removeClass('hidden').addClass('active');
                        $('[data-tab]').removeClass('active text-blue-600 border-blue-600').addClass('text-gray-500 border-transparent');
                        $('[data-tab="bag-history"]').addClass('active text-blue-600 border-blue-600').removeClass('text-gray-500 border-transparent');
                    }
                    // Initialize alerts if needed
                    if (typeof AlertsService !== 'undefined' && AlertsService.init) {
                        try {
                            AlertsService.init();
                            console.log('Alerts service initialized');
                        } catch (error) {
                            console.error('Error initializing alerts service:', error);
                        }
                    }
                } else if (linkId === 'logs-link' || linkTextLower.includes('logs') || linkTextLower.includes('audit')) {
                    sectionId = 'logs-section';
                } else if (linkId === 'settings-link' || linkTextLower === 'settings') {
                    sectionId = 'settings-section';
                } else {
                    // For other sections that haven't been implemented yet
                    console.log('Section not implemented:', linkTextLower);
                    alert('This section is coming soon: ' + linkText);
                    return false;
                }
                
                // Switch to the selected section
                switchToSection(sectionId, linkText);
                return false; // Ensure the click doesn't propagate
            });
            
            // All specific link handlers are now handled by menu-navigation.js
            // This code is kept for reference but is no longer active
            
            $('#dashboard-link').on('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                console.log('Direct click on dashboard link');
                $('.submenu-link').removeClass('active');
                $(this).addClass('active');
                switchToSection('dashboard-section', 'Dashboard');
                return false;
            });
            
            $('#live-map-link').on('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                console.log('Direct click on live map link');
                $('.submenu-link').removeClass('active');
                $(this).addClass('active');
                switchToSection('live-map-section', 'Live Map');
                return false;
            });
            
            $('#collectors-link').on('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                console.log('Direct click on collectors link');
                $('.submenu-link').removeClass('active');
                $(this).addClass('active');
                switchToSection('collectors-section', 'Collectors');
                return false;
            });
            
            $('#pickup-requests-link').on('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                console.log('Direct click on pickup requests link');
                $('.submenu-link').removeClass('active');
                $(this).addClass('active');
                switchToSection('pickup-requests-section', 'Pickup Requests');
                return false;
            });
            
            // Handle Analytics & Reports link
            $('a.submenu-link:contains("Analytics & Reports")').attr('id', 'analytics-link').on('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                console.log('Direct click on analytics link');
                $('.submenu-link').removeClass('active');
                $(this).addClass('active');
                switchToSection('analytics-section', 'Analytics & Reports');
                return false;
            });
            
            // Handle Alerts & Notifications link
            $('a.submenu-link:contains("Alerts & Notifications")').attr('id', 'alerts-link').on('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                console.log('Direct click on alerts link');
                $('.submenu-link').removeClass('active');
                $(this).addClass('active');
                switchToSection('alerts-section', 'Alerts & Notifications');
                // Initialize alerts service if available
                if (typeof AlertsService !== 'undefined' && AlertsService.init) {
                    try {
                        AlertsService.init();
                    } catch (error) {
                        console.error('Error initializing alerts service:', error);
                    }
                }
                return false;
            });
            
            // Handle Logs & Audit Trail link
            $('a.submenu-link:contains("Logs & Audit Trail")').attr('id', 'logs-link').on('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                console.log('Direct click on logs link');
                $('.submenu-link').removeClass('active');
                $(this).addClass('active');
                switchToSection('logs-section', 'Logs & Audit Trail');
                return false;
            });
            
            // Handle Settings link
            $('a.submenu-link:contains("Settings")').attr('id', 'settings-link').on('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                console.log('Direct click on settings link');
                $('.submenu-link').removeClass('active');
                $(this).addClass('active');
                switchToSection('settings-section', 'Settings');
                return false;
            });
            
            // Initialize all action buttons
            $('button').on('click', function(e) {
                e.preventDefault();
                console.log('Button clicked:', $(this).text().trim());
                
                // Handle specific button actions
                if ($(this).text().includes('Export Report')) {
                    alert('Export Report functionality coming soon!');
                } else if ($(this).text().includes('New Pickup Request')) {
                    alert('New Pickup Request form coming soon!');
                } else if ($(this).text().includes('Refresh Map')) {
                    if (MapService.refreshLiveMap) {
                        MapService.refreshLiveMap();
                    }
                    alert('Map refreshed!');
                } else if ($(this).text().includes('Filter')) {
                    alert('Filter functionality coming soon!');
                } else if ($(this).text().includes('Add Collector')) {
                    alert('Add Collector form coming soon!');
                } else {
                    // Generic action for other buttons
                    alert('This action will be implemented in a future update.');
                }
                
                return false;
            });
            
            // Map filter button event listener - jQuery version
            $('.map-filter-btn[data-filter="filter"]').on('click', function() {
                $('#map-filter-panel').toggleClass('hidden');
            });
            
            // Close filter panel button - jQuery version
            $('.close-filter').on('click', function() {
                $('#map-filter-panel').addClass('hidden');
            });
            
            // Handle map control buttons
            $('.map-filter-btn').on('click', function() {
                const filterType = $(this).data('filter');
                console.log('Map control clicked:', filterType);
                
                if (filterType === 'zoom-in' || filterType === 'zoom-out' || 
                    filterType === 'layers' || filterType === 'location') {
                    if (MapService.handleMapControl) {
                        MapService.handleMapControl(filterType);
                    }
                }
            });
            
            // Initialize emergency logout functionality from the user account system
            try {
                // Create emergency logout button
                const emergencyLogoutBtn = $('<button>', {
                    id: 'emergency-logout-btn',
                    class: 'fixed bottom-4 right-4 bg-red-600 text-white rounded-full p-3 shadow-lg z-50',
                    html: '<i class="fas fa-power-off"></i>',
                    title: 'Emergency Logout'
                });
                
                // Add to body
                $('body').append(emergencyLogoutBtn);
                
                // Add click handler
                $('#emergency-logout-btn').on('click', function() {
                    console.log('Emergency logout triggered');
                    alert('Emergency logout triggered. Clearing all sessions...');
                    
                    // Clear all storage
                    localStorage.clear();
                    sessionStorage.clear();
                    
                    // Clear cookies
                    document.cookie.split(';').forEach(function(c) {
                        document.cookie = c.trim().split('=')[0] + '=;expires=Thu, 01 Jan 1970 00:00:00 UTC;path=/';
                    });
                    
                    // Redirect to login page
                    setTimeout(function() {
                        window.location.href = 'login.html';
                    }, 1000);
                });
                
                // Add keyboard shortcut (Ctrl+Alt+L)
                $(document).on('keydown', function(e) {
                    if (e.ctrlKey && e.altKey && e.key === 'l') {
                        $('#emergency-logout-btn').click();
                    }
                });
                
                console.log('Emergency logout functionality initialized');
            } catch (error) {
                console.error('Error initializing emergency logout:', error);
            }
        });
    </script>
</body>
</html>