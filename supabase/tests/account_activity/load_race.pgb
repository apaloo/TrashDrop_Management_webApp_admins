\set g random(1, 200)
\set r random(1, 100)
BEGIN;
SELECT set_config('request.jwt.claim.sub', '44444444-0000-0000-0000-' || lpad(:g::text, 12, '0'), true);
SELECT 1 FROM illegal_dumping_mobile WHERE id = ('66666666-0000-0000-0000-' || lpad(:r::text, 12, '0'))::uuid FOR UPDATE;
SELECT set_config('app.td_claim', 'on', true);
UPDATE illegal_dumping_mobile SET assigned_to = ('33333333-0000-0000-0000-' || lpad(:g::text, 12, '0'))::uuid
 WHERE id = ('66666666-0000-0000-0000-' || lpad(:r::text, 12, '0'))::uuid AND assigned_to IS NULL AND status = 'verified';
SELECT set_config('app.td_claim', '', true);
UPDATE illegal_dumping_mobile SET status = 'in_progress' WHERE id = ('66666666-0000-0000-0000-' || lpad(:r::text, 12, '0'))::uuid
 AND status = 'verified' AND assigned_to = ('33333333-0000-0000-0000-' || lpad(:g::text, 12, '0'))::uuid;
UPDATE illegal_dumping_mobile SET status = 'completed' WHERE id = ('66666666-0000-0000-0000-' || lpad(:r::text, 12, '0'))::uuid
 AND status = 'in_progress' AND assigned_to = ('33333333-0000-0000-0000-' || lpad(:g::text, 12, '0'))::uuid;
COMMIT;
