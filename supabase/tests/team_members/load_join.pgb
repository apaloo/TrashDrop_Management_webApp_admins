\set u :client_id + 1
SELECT set_config('request.jwt.claim.sub', '55555555-0000-0000-0000-' || lpad(:u::text, 12, '0'), false);
SELECT set_config('request.jwt.claims', '{"email":"race@example.com"}', false);
DO $$ BEGIN PERFORM public.team_accept_invite((SELECT token FROM tokens WHERE name = 'race')); EXCEPTION WHEN OTHERS THEN NULL; END $$;
