# TrashDrop Management WebApp Admin Portal - REAL DATA ONLY Environment
# This configuration forces the application to use only real Supabase data with no mock fallbacks

# Core Settings
REACT_APP_DOMAIN=trashdrop.com
REACT_APP_BASE_URL=https://admin.trashdrop.com
REACT_APP_API_BASE_URL=https://api.trashdrop.com

# Supabase Configuration (REQUIRED)
# These must be set to your actual Supabase values
REACT_APP_SUPABASE_URL=${REACT_APP_SUPABASE_URL}
REACT_APP_SUPABASE_ANON_KEY=${REACT_APP_SUPABASE_ANON_KEY}
REACT_APP_SUPABASE_SERVICE_KEY=${REACT_APP_SUPABASE_SERVICE_KEY}

# Force Real Data Configuration
REACT_APP_FORCE_LIVE_DATA=true
REACT_APP_DISABLE_MOCK_DATA=true
REACT_APP_REQUIRE_DATABASE=true
REACT_APP_USE_DEV_AUTH=false

# Feature Flags - All Enabled
REACT_APP_ENABLE_LIVE_MAP=true
REACT_APP_ENABLE_REALTIME_ALERTS=true
REACT_APP_ENABLE_BATCH_OPERATIONS=true
REACT_APP_ENABLE_PERFORMANCE_MONITORING=true
REACT_APP_ENABLE_REALTIME_SUBSCRIPTIONS=true

# Production Mode
NODE_ENV=production
