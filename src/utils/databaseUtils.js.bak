// Simplified query for pickup requests without foreign keys
export const fetchPickupRequestsSimple = async (status = null) => {
  try {
    let query = supabase
      .from('pickup_requests')
      .select('*')
      .order('created_at', { ascending: false });
    
    if (status && status !== 'All') {
      query = query.eq('status', status);
    }
    
    const result = await safeDatabaseService.safeQuery('pickup_requests', query, []);
    return result.data || [];
  } catch (error) {
    console.error('Error fetching simplified pickup requests:', error);
    return [];
  }
};

