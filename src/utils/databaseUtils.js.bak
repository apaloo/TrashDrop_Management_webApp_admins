// Legacy function - keeping for backwards compatibility
export const fetchSystemLogs = async (filters = {}) => {
  try {
    return await fetchLogs(filters.level, filters.source, filters.dateRange, filters.search);
  } catch (error) {
    console.error('Error in fetchSystemLogs:', error);
    return generateMockLogs(filters.level, filters.source, filters.dateRange, filters.search);
  }
};

