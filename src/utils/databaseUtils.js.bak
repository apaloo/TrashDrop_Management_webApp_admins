  try {
    let query = supabase
      .from('alerts')
      .select('*')
      .order('created_at', { ascending: false });
    
    if (status && status !== 'All') {
      query = query.eq('status', status);
    }
    
    const result = await safeDatabaseService.safeQuery('alerts', query, []);
    return result.data || [];
  } catch (error) {
    console.error('Error fetching simplified alerts:', error);
    return [];
  }
};

