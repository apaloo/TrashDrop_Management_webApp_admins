// Helper functions for safe database operations

// Simplified query for illegal dumping reports without foreign keys
export const fetchIllegalDumpingReportsSimple = async (status = null) => {
  try {
    let query = supabase
      .from('illegal_dumping')
      .select('*')
      .limit(appConfig.database.queryLimits.illegalDumping)
      .order('reported_at', { ascending: false });
    
    if (status && status !== 'All') {
      query = query.eq('status', status);
    }
    
    const result = await safeDatabaseService.safeQuery('illegal_dumping', query, []);
    return result.data || [];
  } catch (error) {
    console.error('Error fetching simplified illegal dumping reports:', error);
    return [];
  }
};

