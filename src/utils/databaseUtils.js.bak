// Fetch chart data for the dashboard
export const fetchChartData = async (chartType) => {
  try {
    switch (chartType) {
      case 'collections':
        // Daily collections for the past 7 days
        const collectionsQuery = supabase.rpc('get_daily_collections');
        const collectionsResult = await safeDatabaseService.safeQuery('collections', collectionsQuery, generateMockCollectionsData());
        return collectionsResult.data;
        
      case 'waste_distribution':
        // Distribution by waste type
        const wasteQuery = supabase.rpc('get_waste_distribution');
        const wasteResult = await safeDatabaseService.safeQuery('waste', wasteQuery, generateMockWasteDistribution());
        return wasteResult.data;
        
      case 'collector_performance':
        // Collector performance metrics
        const performanceQuery = supabase.rpc('get_collector_performance');
        const performanceResult = await safeDatabaseService.safeQuery('performance', performanceQuery, generateMockCollectorPerformance());
        return performanceResult.data;
        
      default:
        throw new Error(`Unknown chart type: ${chartType}`);
    }
  } catch (error) {
    console.error(`Error fetching chart data for ${chartType}:`, error);
    throw error;
  }
};

