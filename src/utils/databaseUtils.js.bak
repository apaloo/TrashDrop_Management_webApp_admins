    date.setDate(today.getDate() - i);
    
    data.push({
      date: date.toISOString().split('T')[0],
      collections: Math.floor(25 + Math.random() * 30),
      weight_kg: Math.floor(150 + Math.random() * 100),
      collectors: Math.floor(3 + Math.random() * 2)
    });
  }
  
  return data;
};

