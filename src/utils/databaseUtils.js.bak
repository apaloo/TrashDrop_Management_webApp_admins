// Keep only the first occurrence of this function
export const generateMockCollectorPerformance = () => {
  return {
    top_collectors: [
      { name: 'Ama Owusu', collections: 38, rating: 4.9, region: 'Ga West Municipal' },
      { name: 'Kwame Asante', collections: 35, rating: 4.8, region: 'Accra Metropolitan' },
      { name: 'Akosua Mensah', collections: 29, rating: 4.6, region: 'Ga North Municipal' },
      { name: 'Kofi Boateng', collections: 24, rating: 4.4, region: 'Ga East Municipal' }
    ],
    efficiency_metrics: {
      avg_time_per_collection: 18, // minutes
      avg_distance_per_day: 15.2, // km
      avg_collections_per_day: 8.5,
      avg_response_time: 22 // minutes
    },
    regional_distribution: [
      { region: 'Accra Metropolitan', collections: 120, collectors: 12 },
      { region: 'Ga North Municipal', collections: 85, collectors: 8 },
      { region: 'Ga South Municipal', collections: 70, collectors: 7 },
      { region: 'Ga East Municipal', collections: 65, collectors: 6 },
      { region: 'Ga West Municipal', collections: 60, collectors: 6 }
    ]
  };
};
    }

    // Calculate pagination range
    const from = (page - 1) * limit;
    const to = from + limit - 1;

    // Start building the query
    let query = supabase
      .from('batches')
      .select('*', { count: 'exact' })
      .range(from, to);

    // Apply sorting with fallback for column names
    // Handle common column name variations
    let actualSortField = sortField;
    if (sortField === 'created_at') {
      // Try different possible column names
      actualSortField = 'updated_at'; // This seems to be the actual column name
    }
    
    try {
      query = query.order(actualSortField, { ascending: sortDirection === 'asc' });
    } catch (sortError) {
      // If sorting fails, use a simple fallback
      console.warn(`Sort field '${actualSortField}' not found, using 'id' instead`);
      query = query.order('id', { ascending: false });
    }

    // Apply filters if provided
    if (filters.status && filters.status !== 'All') {
      query = query.eq('status', filters.status);
    }
    
    if (filters.search && filters.search.trim() !== '') {
      // Search by ID or type
      const searchTerm = filters.search.trim();
      query = query.or(
        `id.ilike.%${searchTerm}%,type.ilike.%${searchTerm}%,qr_prefix.ilike.%${searchTerm}%`
      );
    }

    // Execute the query with safe error handling
    const result = await safeDatabaseService.safeQuery('batches', query, generateMockBagBatches(limit));
    
    // Handle specific database errors gracefully
    if ((result.error && result.error.code === '42703') || (result.error && result.error.message && result.error.message.includes('does not exist'))) {
      console.warn('Database schema issue detected, falling back to mock data:', result.error.message);
      const mockData = generateMockBagBatches(limit);
      return {
        data: mockData,
        totalCount: mockData.length,
        page,
        limit,
        totalPages: Math.ceil(mockData.length / limit)
      };

