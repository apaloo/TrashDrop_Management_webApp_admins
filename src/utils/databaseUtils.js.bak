/**
 * Generate mock bag batch data
 * @param {number} count - Number of batch records to generate
 * @returns {Array} Array of mock bag batch objects
 */
export const generateMockBagBatches = (count = 10) => {
  return Array.from({ length: count }, (_, index) => ({
    id: `batch_${index + 1}`,
    created_at: new Date(Date.now() - (index * 24 * 60 * 60 * 1000)).toISOString(),
    updated_at: new Date(Date.now() - (index * 24 * 60 * 60 * 1000)).toISOString(),
    quantity: Math.floor(Math.random() * 100) + 10,
    type: ['standard', 'biodegradable', 'heavy-duty'][Math.floor(Math.random() * 3)],
    size: ['small', 'medium', 'large'][Math.floor(Math.random() * 3)],
    status: ['active', 'distributed', 'expired'][Math.floor(Math.random() * 3)],
    distributed: Math.floor(Math.random() * 80),
    scanned: Math.floor(Math.random() * 60),
    qr_prefix: `QR${String(index + 1).padStart(3, '0')}`
  }));
};

