// Update alert status
export const updateAlertStatus = async (id, status) => {
  try {
    const query = supabase
      .from('alerts')
      .update({ status })
      .eq('id', id)
      .select()
      .single();
    
    const result = await safeDatabaseService.safeQuery('alerts', query, { status, id });
    return result.data;
  } catch (error) {
    console.error('Error updating alert status:', error);
    return { error };

