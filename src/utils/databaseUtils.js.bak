      user: { email: 'admin@example.com', first_name: 'Admin', last_name: 'User' }
    },
    {
      id: 'alert-002',
      created_at: new Date(Date.now() - 3600000).toISOString(),
      status: 'resolved',
      type: 'collector',
      title: 'Collector Offline',
      message: 'Collector #123 has been offline for 30 minutes',
      severity: 'high',
      user: { email: 'ops@example.com', first_name: 'Operations', last_name: 'Team' }
    }
  ];
  
  if (status && status !== 'All') {
    return mockData.filter(item => item.status === status);
  }
  return mockData;
};

