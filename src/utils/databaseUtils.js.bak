// Fetch collectors
export const fetchCollectors = async (status = null) => {
  try {
    // safeDatabaseService is now imported statically at the top of the file
    
    let query = supabase
      .from('collectors')
      .select(`
        *,
        profile:profiles(*)
      `)
      .limit(appConfig.database.queryLimits.collectors);
    
    if (status) {
      query = query.eq('status', status);
    }
    
    const result = await safeDatabaseService.safeQuery('collectors', query, generateMockCollectors(status));
    return result.data || [];
  } catch (error) {
    console.error('Error fetching collectors:', error);
    return generateMockCollectors(status);
  }
};

