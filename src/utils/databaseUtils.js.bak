// Update collector status only
export const updateCollectorStatus = async (id, status) => {
  try {
    const { data, error } = await supabase
      .from('collectors')
      .update({ status })
      .eq('id', id)
      .select();
      
    if (error) {
      console.error('Error updating collector status:', error);
      return { error };

