/**
 * Alerts Management Database Operations
 */

// Fetch alerts
export const fetchAlerts = async (status = null) => {
  try {
    // Use safeDatabaseService to handle missing tables gracefully
    // safeDatabaseService is now imported statically at the top of the file
    
    let query = supabase
      .from('alerts')
      .select(`
        *,
        user:user_id (id, email, first_name, last_name)
      `)
      .order('created_at', { ascending: false });
    
    if (status && status !== 'All') {
      query = query.eq('status', status);
    }
    
    const result = await safeDatabaseService.safeQuery('alerts', query, generateMockAlerts(status));
    if (!result) {
      console.warn('Table alerts does not exist. Returning mock data.');
      return generateMockAlerts(status);
    }
    
    // Handle foreign key relationship errors gracefully
    if ((result.error && result.error.code === 'PGRST200') || (result.error && result.error.message && result.error.message.includes('relationship'))) {
      console.warn('Foreign key relationships not set up for alerts. Using simplified query.');
      return await fetchAlertsSimple(status);
    }
    
    return result.data || [];
  } catch (error) {
    console.error('Error fetching alerts:', error);
    return generateMockAlerts(status);
  }
};

