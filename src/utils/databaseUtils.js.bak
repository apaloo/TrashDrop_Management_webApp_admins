      avg_response_time: 22 // minutes
    },
    regional_distribution: [
      { region: 'Accra Metropolitan', collections: 120, collectors: 12 },
      { region: 'Ga North Municipal', collections: 85, collectors: 8 },
      { region: 'Ga South Municipal', collections: 70, collectors: 7 },
      { region: 'Ga East Municipal', collections: 65, collectors: 6 },
      { region: 'Ga West Municipal', collections: 60, collectors: 6 }
    ]
  };
};

    const queries = [
      { table: 'bags', query: supabase.from('bags').select('*', { count: 'exact', head: true }) },
      { table: 'batches', query: supabase.from('batches').select('*', { count: 'exact', head: true }).eq('status', 'Active') },
      { table: 'scans', query: supabase.from('scans').select('*', { count: 'exact', head: true }) },
      { table: 'pickup_requests', query: supabase.from('pickup_requests').select('*', { count: 'exact', head: true }).eq('status', 'Pending') },
      { table: 'collectors', query: supabase.from('collectors').select('*', { count: 'exact', head: true }).eq('status', 'Active') },
      { table: 'illegal_dumping', query: supabase.from('illegal_dumping').select('*', { count: 'exact', head: true }).not('status', 'eq', 'Cleaned Up') }
    ];

    const results = await Promise.all(
      queries.map(({ table, query }) => 
        safeDatabaseService.safeQuery(table, query, { count: mockStats[table === 'bags' ? 'totalBags' : 
                                                             table === 'batches' ? 'activeBatches' : 
                                                             table === 'scans' ? 'totalCollections' : 
                                                             table === 'pickup_requests' ? 'pendingRequests' : 
                                                             table === 'collectors' ? 'activeCollectors' : 
                                                             'unresolvedDumping'] })
      )
    );

    const stats = {
      totalBags: results[0].count || mockStats.totalBags,
      activeBatches: results[1].count || mockStats.activeBatches,
      totalCollections: results[2].count || mockStats.totalCollections,
      pendingRequests: results[3].count || mockStats.pendingRequests,
      activeCollectors: results[4].count || mockStats.activeCollectors,
      unresolvedDumping: results[5].count || mockStats.unresolvedDumping
    };

