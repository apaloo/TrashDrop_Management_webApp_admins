// Mock data generator for logs
export const generateMockLogs = (level = null, source = null, dateRange = null, searchQuery = '') => {
  const mockData = [
    {
      id: 'log-001',
      timestamp: new Date().toISOString(),
      level: 'info',
      source: 'dashboard',
      message: 'Dashboard metrics updated successfully',
      user_email: 'admin@example.com',
      details: JSON.stringify({ metrics: ['pickups', 'collectors', 'alerts'] })
    },
    {
      id: 'log-002',
      timestamp: new Date(Date.now() - 300000).toISOString(),
      level: 'warning',
      source: 'collector',
      message: 'Collector response time exceeded threshold',
      user_email: 'collector@example.com',
      details: JSON.stringify({ response_time: '15s', threshold: '10s' })
    },
    {
      id: 'log-003',
      timestamp: new Date(Date.now() - 600000).toISOString(),
      level: 'error',
      source: 'pickup',
      message: 'Failed to process pickup request',
      user_email: 'system@example.com',
      details: JSON.stringify({ error: 'Database connection timeout', request_id: 'pickup-123' })
    }
  ];
  
  let filteredData = mockData;
  
  if (level) {
    filteredData = filteredData.filter(item => item.level === level);
  }
  
  if (source) {
    filteredData = filteredData.filter(item => item.source === source);
  }
  
  if (searchQuery) {
    const query = searchQuery.toLowerCase();
    filteredData = filteredData.filter(item => 
      item.message.toLowerCase().includes(query) ||
      item.user_email.toLowerCase().includes(query) ||
      item.details.toLowerCase().includes(query)
    );
  }
  
  return filteredData;
};

