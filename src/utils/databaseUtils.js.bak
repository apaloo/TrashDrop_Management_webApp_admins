// Simplified query for dumping reports without foreign keys
export const fetchDumpingReportsSimple = async (status = 'reported') => {
  try {
    let query = supabase
      .from('dumping_reports')
      .select('*')
      .eq('status', status)
      .order('created_at', { ascending: false });
    
    const result = await safeDatabaseService.safeQuery('dumping_reports', query, []);
    return result.data || [];
  } catch (error) {
    console.error('Error fetching simplified dumping reports:', error);
    return [];
  }
};

